# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt uses tabs; match it so the editor and gofmt never disagree.
[*.go]
indent_style = tab
indent_size = 4

[{go.mod,go.sum}]
indent_style = tab

# Make requires tabs in recipes.
[Makefile]
indent_style = tab

# Trailing double-space is a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false
